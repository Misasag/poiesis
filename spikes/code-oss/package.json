{
  "name": "poiesis-code-oss-spike",
  "displayName": "Poiesis",
  "description": "Code-OSS/VSCodium technical spike for an Agent-first IDE workflow.",
  "version": "0.0.0",
  "private": true,
  "publisher": "poiesis-spike",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:poiesis.openAgentWindow",
    "onCommand:poiesis.openChanges",
    "onView:poiesis.changesView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "poiesis.openAgentWindow",
        "title": "Poiesis: Agent Window を開く"
      },
      {
        "command": "poiesis.openChanges",
        "title": "Poiesis: Changes を開く"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "poiesisChanges",
          "title": "IDE Changes",
          "icon": "media/changes.svg"
        }
      ]
    },
    "views": {
      "poiesisChanges": [
        {
          "type": "webview",
          "id": "poiesis.changesView",
          "name": "Changes"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "prepackage": "node scripts/prepare-package.mjs",
    "package": "npm run build && vsce package --no-dependencies --out artifacts/poiesis-code-oss-spike.vsix",
    "download:host": "node scripts/download-vscodium.mjs",
    "start": "node scripts/start-host.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "validate:source": "node scripts/validate-source.mjs"
  },
  "files": [
    "dist/**",
    "media/**",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.2",
    "extract-zip": "^2.0.1",
    "puppeteer-core": "^24.16.0",
    "typescript": "^5.9.2"
  }
}
