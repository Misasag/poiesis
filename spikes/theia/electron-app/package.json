{
  "name": "@poiesis/theia-electron-app",
  "productName": "Poiesis",
  "version": "0.0.0",
  "private": true,
  "main": "lib/backend/electron-main.js",
  "dependencies": {
    "@poiesis/theia-agent-window": "0.0.0",
    "@theia/bulk-edit": "1.73.1",
    "@theia/core": "1.73.1",
    "@theia/editor": "1.73.1",
    "@theia/electron": "1.73.1",
    "@theia/filesystem": "1.73.1",
    "@theia/markers": "1.73.1",
    "@theia/messages": "1.73.1",
    "@theia/monaco": "1.73.1",
    "@theia/navigator": "1.73.1",
    "@theia/outline-view": "1.73.1",
    "@theia/output": "1.73.1",
    "@theia/plugin-ext": "1.73.1",
    "@theia/plugin-ext-vscode": "1.73.1",
    "@theia/preferences": "1.73.1",
    "@theia/process": "1.73.1",
    "@theia/scm": "1.73.1",
    "@theia/scm-extra": "1.73.1",
    "@theia/search-in-workspace": "1.73.1",
    "@theia/task": "1.73.1",
    "@theia/terminal": "1.73.1",
    "@theia/userstorage": "1.73.1",
    "@theia/variable-resolver": "1.73.1",
    "@theia/vsx-registry": "1.73.1",
    "@theia/workspace": "1.73.1"
  },
  "devDependencies": {
    "@theia/cli": "1.73.1",
    "electron": "39.8.7"
  },
  "scripts": {
    "build": "node ../scripts/build-electron.mjs",
    "clean": "theia clean",
    "icon:build": "node ../scripts/build-icon.mjs",
    "rebuild": "node ../scripts/run-electron-rebuild.mjs",
    "start": "set \"THEIA_CONFIG_DIR=%CD%\\..\\.theia-config-electron\" && theia start ../../.. --plugins=local-dir:../plugins --electronUserData=../.electron-runtime/user-data"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Poiesis",
        "reloadOnReconnect": true,
        "electron": {
          "windowOptions": {
            "icon": "resources/poiesis.ico"
          }
        },
        "preferences": {
          "security.workspace.trust.enabled": false,
          "extensions.ignoreRecommendations": true
        }
      }
    },
    "backend": {
      "config": {
        "frontendConnectionTimeout": -1,
        "configureProxyFromPreferences": true
      }
    }
  }
}
