{
  "name": "@poiesis/theia-browser-app",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@poiesis/theia-agent-window": "0.0.0",
    "@theia/bulk-edit": "1.73.1",
    "@theia/core": "1.73.1",
    "@theia/editor": "1.73.1",
    "@theia/filesystem": "1.73.1",
    "@theia/markers": "1.73.1",
    "@theia/messages": "1.73.1",
    "@theia/monaco": "1.73.1",
    "@theia/navigator": "1.73.1",
    "@theia/outline-view": "1.73.1",
    "@theia/output": "1.73.1",
    "@theia/plugin-ext": "1.73.1",
    "@theia/plugin-ext-vscode": "1.73.1",
    "@theia/preferences": "1.73.1",
    "@theia/process": "1.73.1",
    "@theia/scm": "1.73.1",
    "@theia/scm-extra": "1.73.1",
    "@theia/search-in-workspace": "1.73.1",
    "@theia/task": "1.73.1",
    "@theia/terminal": "1.73.1",
    "@theia/userstorage": "1.73.1",
    "@theia/variable-resolver": "1.73.1",
    "@theia/vsx-registry": "1.73.1",
    "@theia/workspace": "1.73.1"
  },
  "devDependencies": {
    "@theia/cli": "1.73.1"
  },
  "scripts": {
    "build": "npm run rebuild && theia build --mode development",
    "clean": "theia clean",
    "rebuild": "theia rebuild:browser --cacheRoot ..",
    "start": "set \"THEIA_CONFIG_DIR=%CD%\\..\\.theia-config\" && theia start .. --plugins=local-dir:../plugins --hostname 127.0.0.1 --port 3000"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Poiesis",
        "preferences": {
          "security.workspace.trust.enabled": false,
          "extensions.ignoreRecommendations": true
        }
      }
    }
  }
}
