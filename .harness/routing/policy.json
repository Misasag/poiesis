{
  "version": 2,
  "data_policy": { "allow_may_train": true, "repo_visibility": "public" },
  "lambda_cost": 0.05,
  "lambda_time": 0.0001,
  "explore_share": 0.2,
  "min_n_for_promotion": 10,
  "noninferiority_margin": 0.05,
  "task_classes": ["app-backend", "app-frontend", "app-test", "harness", "docs", "mechanical"],
  "roles": {
    "orchestrator": { "fixed": true, "incumbent": "Claude Code session", "notes": "Informational only; the current orchestrator is not spawned by hx." },
    "worker-design": { "incumbent": "codex:gpt-6-astra", "effort": "xhigh", "challengers": ["codex:gpt-6-sol", "claude:opus", "or:glm-5.3", "or:kimi-k3"] },
    "worker-mech": { "incumbent": "codex:gpt-6-luna", "effort": "medium", "challengers": ["codex:gpt-6-sol", "or:glm-5.3-flash", "or:deepseek-v4.1-flash", "or:mimo-v2.6-pro", "grok:default"] },
    "reviewer": { "incumbent": "claude:opus", "fallback": "codex:gpt-6-sol", "rule": "family must differ from worker" },
    "gate": { "incumbent": "jev", "effort": "default" },
    "judge": { "incumbent": "claude:opus", "fallback": "codex:gpt-6-sol", "challengers": ["or:glm-5.3", "or:deepseek-v4.1-flash"], "rule": "best-scoring allowed family; exclude every candidate family" },
    "recon": { "incumbent": "grok:default" }
  }
}
