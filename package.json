{
  "name": "poiesis-theia-spike",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "A focused Eclipse Theia technical spike for the Poiesis core UX.",
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "agent-window",
    "browser-app",
    "electron-app"
  ],
  "scripts": {
    "build": "npm run compile --workspace=@poiesis/theia-agent-window && npm run build --workspace=@poiesis/theia-browser-app",
    "build:electron": "npm run compile --workspace=@poiesis/theia-agent-window && npm run build --workspace=@poiesis/theia-electron-app",
    "clean": "npm run clean --workspace=@poiesis/theia-agent-window && npm run clean --workspace=@poiesis/theia-browser-app && npm run clean --workspace=@poiesis/theia-electron-app",
    "download:plugins": "theia download:plugins",
    "dist:win": "node scripts/dist-win.mjs",
    "rebuild": "npm run rebuild --workspace=@poiesis/theia-browser-app",
    "rebuild:electron": "npm run rebuild --workspace=@poiesis/theia-electron-app",
    "release:local": "node scripts/release-local.mjs",
    "serve:updates": "node scripts/serve-updates.mjs",
    "shots:design": "node scripts/capture-design-shots.mjs",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "smoke:composer": "set \"POIESIS_COMPOSER_ONLY=1\" && node scripts/smoke-electron.mjs",
    "smoke:task-feedback": "set \"POIESIS_TASK_FEEDBACK_ONLY=1\" && set \"POIESIS_AGENT_TEST_REPLY=Task completed.\" && set \"POIESIS_AGENT_TEST_DELAY_MS=2500\" && set \"POIESIS_AGENT_TEST_ACTIVITIES=1\" && set \"POIESIS_RESULTS_GENERATION_FORCE_FAILURE=1\" && node scripts/smoke-electron.mjs",
    "smoke:installed": "node scripts/smoke-installed.mjs",
    "smoke:agent-rich-content": "npm run build && node scripts/smoke-agent-rich-content.mjs",
    "smoke:code-branch-picker": "npm run build && node scripts/smoke-code-branch-picker.mjs",
    "smoke:markdown": "node scripts/smoke-markdown.mjs",
    "smoke:resize": "node scripts/smoke-resize.mjs",
    "smoke:results-question": "npm run build && node scripts/smoke-results-question.mjs",
    "smoke:results-citation": "npm run build && node scripts/smoke-results-document.mjs citation",
    "smoke:results-document": "npm run build && node scripts/smoke-results-document.mjs citation && node scripts/smoke-results-document.mjs fallback",
    "smoke:results-fallback": "npm run build && node scripts/smoke-results-document.mjs fallback",
    "smoke:restored-new-chat": "node scripts/smoke-restored-new-chat.mjs",
    "smoke:round10": "node scripts/smoke-round10-browser.mjs",
    "smoke:round13": "node scripts/smoke-round13-browser.mjs",
    "smoke:round14": "node scripts/smoke-round14-browser.mjs",
    "smoke:round15": "node scripts/smoke-round15-browser.mjs",
    "smoke:round16": "node scripts/smoke-round16-console.mjs",
    "smoke:round17": "node scripts/smoke-round17-browser.mjs",
    "smoke:round20": "node scripts/smoke-round20-browser.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "smoke:update": "node scripts/smoke-update.mjs",
    "start": "npm run start --workspace=@poiesis/theia-browser-app",
    "start:background": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-background.ps1",
    "stop:background": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-background.ps1",
    "start:electron": "npm run start --workspace=@poiesis/theia-electron-app --",
    "test:composer": "npm run compile --workspace=@poiesis/theia-agent-window && node scripts/test-composer-behavior.mjs",
    "test:agent-activity": "npm run compile --workspace=@poiesis/theia-agent-window && node scripts/test-agent-activity-parser.mjs",
    "test:results-normalizer": "npm run compile --workspace=@poiesis/theia-agent-window && node scripts/test-results-normalizer.mjs",
    "test:results-prompt-transport": "npm run compile --workspace=@poiesis/theia-agent-window && node scripts/test-results-prompt-transport.mjs",
    "test:requirements": "npm run compile --workspace=@poiesis/theia-agent-window && node scripts/test-requirement-model.mjs",
    "test:requirement-classifier": "npm run compile --workspace=@poiesis/theia-agent-window && node scripts/test-requirement-classifier.mjs",
    "test:snapshot-store": "npm run compile --workspace=@poiesis/theia-agent-window && node scripts/test-snapshot-store.mjs",
    "test:skill-document": "npm run compile --workspace=@poiesis/theia-agent-window && node scripts/test-skill-document.mjs",
    "validate:source": "node scripts/validate-source.mjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@theia/cli": "1.73.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "electron-builder": "26.15.7",
    "puppeteer-core": "25.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "terser-webpack-plugin": "^5.3.14",
    "typescript": "~5.9.3"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode-builtin-extensions": "https://github.com/eclipse-theia/vscode-builtin-extensions/releases/download/1.108.2/vscode-builtin-extensions-1.108.2.tar.gz"
  }
}
